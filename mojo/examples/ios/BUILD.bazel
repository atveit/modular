# Example-local diagnostic only: emits a runtime-free Simulator archive and C
# header. It is not wired into root packaging or an ios_application target.
mojo_ios_static_library(
    name = "mojo_ios_static_library_smoke",
    src = "mojo_ios_smoke.mojo",
    header = "mojo_ios_smoke.h",
    tags = ["manual"],
)

mojo_ios_static_library(
    name = "mojo_ios_static_library_device_smoke",
    src = "mojo_ios_smoke.mojo",
    header = "mojo_ios_smoke.h",
    platform = "IOS",
    sdk_name = "iphoneos",
    tags = ["manual"],
    target_cpu = "apple-a7",
    target_triple = "arm64-apple-ios17.0",
)

# Diagnostic archive only. This recompiles explicit sources with Xcode's
# iPhoneSimulator SDK; it never repackages CompilerRTIOSBootstrapHost's archive.
compilerrt_ios_simulator_bootstrap_archive(
    name = "compilerrt_ios_simulator_bootstrap_archive_diagnostic",
    srcs = ["//KGEN:CompilerRTIOSBootstrapSources"],
    tags = [
        "manual",
        "requires-xcode",
    ],
)

_IOS_CORE_SEED_SYMBOLS = [
    "_KGEN_CompilerRT_AlignedAlloc",
    "_KGEN_CompilerRT_AlignedFree",
    "_KGEN_CompilerRT_DestroyGlobals",
    "_KGEN_CompilerRT_GetGlobalOrNull",
    "_KGEN_CompilerRT_GetOrCreateGlobal",
    "_KGEN_CompilerRT_GetOrCreateGlobalIndexed",
    "_KGEN_CompilerRT_GetStackTrace",
    "_KGEN_CompilerRT_Initialize",
    "_KGEN_CompilerRT_InsertGlobal",
    "_KGEN_CompilerRT_fprintf",
]

# Bounded non-AsyncRT core seed used by the emitted-Mojo global/Error probe.
# Both archives are compiled from source with the matching Xcode SDK; neither
# repackages the host-built //KGEN:CompilerRTIOSBootstrapHost output.
compilerrt_ios_static_archive(
    name = "compilerrt_ios_core_simulator_archive",
    srcs = ["//KGEN:CompilerRTIOSCoreSources"],
    expected_symbols = _IOS_CORE_SEED_SYMBOLS,
    tags = [
        "manual",
        "requires-xcode",
    ],
)

compilerrt_ios_static_archive(
    name = "compilerrt_ios_core_device_archive",
    srcs = ["//KGEN:CompilerRTIOSCoreSources"],
    expected_symbols = _IOS_CORE_SEED_SYMBOLS,
    minimum_os_flag = "-miphoneos-version-min=17.0",
    platform = "IOS",
    sdk_name = "iphoneos",
    tags = [
        "manual",
        "requires-xcode",
    ],
    target_triple = "arm64-apple-ios17.0",
)

# Compatibility labels for existing automation. New consumers should use the
# serial-core names above.
alias(
    name = "compilerrt_ios_core_seed_simulator_archive",
    actual = ":compilerrt_ios_core_simulator_archive",
)

alias(
    name = "compilerrt_ios_core_seed_device_archive",
    actual = ":compilerrt_ios_core_device_archive",
)

