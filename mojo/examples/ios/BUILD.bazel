package(default_visibility = ["//visibility:public"])

# This is intentionally a source fixture rather than a runnable Bazel iOS
# target.  The repository does not yet register rules_apple/rules_swift, and
# the Mojo toolchain currently has macOS-only executable-link behavior.  The
# shell harness performs the target-object/archive/link smoke test with the
# host Mojo compiler and Xcode's iPhone Simulator SDK.
filegroup(
    name = "ios_simulator_smoke_fixture",
    srcs = [
        "Info.plist",
        "APPLE_FRAMEWORK_COVERAGE.md",
        "README.md",
        "mojo_ios_smoke.h",
        "mojo_ios_smoke.mojo",
        "run_simulator_smoke.sh",
        "smoke_main.c",
        "swiftui_host/BUILD.bazel",
        "swiftui_host/MojoIOSSmoke.modulemap",
        "swiftui_host/MojoIOSSmokeApp.swift",
        "swiftui_host/README.md",
        "swiftui_host/compile_swiftui_host.sh",
        "swiftui_host/link_swiftui_host.sh",
    ],
)

exports_files([
    "Info.plist",
    "README.md",
    "mojo_ios_smoke.h",
    "mojo_ios_smoke.mojo",
    "run_simulator_smoke.sh",
    "smoke_main.c",
])
