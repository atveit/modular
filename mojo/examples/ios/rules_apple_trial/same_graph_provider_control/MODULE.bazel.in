module(
    name = "mojo_ios_same_graph_provider_control",
    version = "0.0.0",
)

# The runner substitutes the absolute checkout path into this disposable module.
bazel_dep(name = "modular", version = "0")
local_path_override(module_name = "modular", path = "__MODULAR_ROOT__")

bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "rules_apple")
bazel_dep(
    name = "rules_swift",
    version = "3.5.0",
    repo_name = "build_bazel_rules_swift",
)
bazel_dep(name = "rules_cc", version = "0.2.18")
